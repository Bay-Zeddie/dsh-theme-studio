{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom"],
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": ["index.js", "lib/*.js", "client.js", "tools/**/*.mjs", "tools/types/*.d.ts"]
}
